# ====================================================================
# JOHN STAYTE SERVICES - ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Twilio (SMS & Verify)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_API_KEY_SID=your-twilio-api-key-sid
TWILIO_API_KEY_SECRET=your-twilio-api-key-secret
TWILIO_ALPHA_SENDER_ID=JOHNSTAYTE
TWILIO_VERIFY_EMAIL_SERVICE_SID=your-verify-email-service-sid

# Resend (Email Verification)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.co.uk

# Elavon Payment Gateway (EPG) / Converge
# Set ELAVON_ENV to 'production' for live payments or 'sandbox' for test payments
ELAVON_ENV=sandbox
ELAVON_MERCHANT_ALIAS=your_merchant_alias_here
ELAVON_SECRET_KEY=sk_your_secret_key_here
ELAVON_PUBLIC_KEY=pk_your_public_key_here
ELAVON_PROCESSOR_ID=your_processor_id_here

# Elavon Converge Legacy Credentials (Alternative integration)
ELAVON_CONVERGE_ENV=demo
ELAVON_CONVERGE_ACCOUNT_ID=your_converge_account_id
ELAVON_CONVERGE_USER_ID=your_converge_user_id
ELAVON_CONVERGE_PIN=your_converge_pin
